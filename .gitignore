!backend/ml/models/xgboost_model.json
!backend/ml/models/xgboost_model.pkl
!backend/ml/models/scaler.pkl
!backend/ml/models/scaler_params.json
!ai-module/*.csv
!ai-module/*.pkl
!ai-module/*.json

# ===== OS =====
.DS_Store
Thumbs.db
*.bak
*.tmp
*.temp
desktop.ini

