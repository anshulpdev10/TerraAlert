# Root .gitignore for GeoSafe Project

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
.venv
env.bak/
venv.bak/
backend/venv/
backend/env/

# ===== Node.js / Frontend =====
node_modules/
frontend/node_modules/
mobile/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
# Note: Some teams ignore lock files, but it's better to commit them
# package-lock.json
# yarn.lock
.pnpm-debug.log

# Build outputs
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
mobile/android/app/build/
mobile/android/build/
mobile/ios/build/
mobile/ios/Pods/

# ===== React Native / Mobile =====
mobile/.expo/
mobile/.expo-shared/
mobile/android/.gradle/
mobile/android/app/build/
mobile/ios/Pods/
mobile/*.jsbundle
mobile/.metro-health-check*
mobile/Podfile.lock

# ===== Environment Variables =====
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
mobile/.env

# Keep example/template env files
!.env.example
!backend/.env.example
!frontend/.env.example
!mobile/.env.development

# ===== IDE / Editors =====
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ===== Database =====
*.db
*.sqlite3
*.sqlite

# ===== Logs =====
*.log
logs/
*.log.*

