.cxx/
*.apk
*.aab

# ===== Node =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Note: Lock files ensure consistent dependency versions
# Uncomment below if you want to ignore them (not recommended)
# package-lock.json
# yarn.lock
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ===== React Native =====
# Bundle artifact
*.jsbundle

# Metro bundler
.metro-health-check*
.metro-health-check-*

# Temporary files
.tmp/
tmp/

# ===== Environment Variables =====
# Keep example files, ignore actual env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.development

# ===== Testing =====
/coverage
*.lcov
.nyc_output

